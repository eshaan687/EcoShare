# EcoShare Environment Configuration Template
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets to version control.

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Configuration (Required for client & SSR requests)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Privileged Server-Only Key (Optional for Milestone 0 dev/builds; never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Transactional Email (Resend - Server-Only, required in Milestone 8)
RESEND_API_KEY=
